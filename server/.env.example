# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

NODE_ENV=development
PORT=3001
DATABASE_URL=
JWT_SECRET=

# Redis (BullMQ Worker Queue)
# Lokal: redis://127.0.0.1:6379  |  Upstash: rediss://default:password@endpoint.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379

# Konfigurasi AI via Sumopod
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=


# Eden AI Configuration
# Ganti model dengan format: provider/nama-model
# Contoh: google/gemini-2.0-flash  |  openai/gpt-4o-mini  |  anthropic/claude-3-haiku
USE_EDENAI=
EDENAI_API_URL=
EDENAI_API_KEY=
EDENAI_MODEL=

# ─────────────────────────────────────────────
# SMTP / EMAIL MAILER
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=false

# ─────────────────────────────────────────────
# MIDTRANS PAYMENT GATEWAY
# ─────────────────────────────────────────────
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=your_sandbox_server_key
MIDTRANS_CLIENT_KEY=your_sandbox_client_key

# ─────────────────────────────────────────────
# Speech-to-Text (STT) Configuration — untuk transkripsi Voice Note
# Format OpenAI-compatible (Whisper API)
# Provider: OpenAI, Groq, Local Whisper, dll.
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3
STT_LANGUAGE=auto

# Public URL for Twilio to access local files (ngrok tunnel)
PUBLIC_URL=
