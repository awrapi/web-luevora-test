generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                      Int                       @id @default(autoincrement()) @db.UnsignedInt
  client_slug             String                    @unique @db.VarChar(100)
  business_name           String                    @db.VarChar(150)
  business_type           String                    @default("course") @db.VarChar(50)
  business_description    String?                   @db.Text
  owner_phone             String?                   @db.VarChar(50)
  owner_email             String?                   @unique @db.VarChar(200)
  subscription_plan       String                    @default("free") @db.VarChar(50)
  subscription_status     String                    @default("active") @db.VarChar(50)
  subscription_expires_at DateTime?                 @db.DateTime(0)
  is_active               Int                       @default(1) @db.TinyInt
  created_at              DateTime?                 @default(now()) @db.DateTime(0)
  updated_at              DateTime?                 @default(now()) @db.DateTime(0)
  active_rentals          ActiveRental[]
  addon_media_files       AddonMediaFile[]
  adv_addons              AdvancedPackageAddon[]
  adv_sub_items           AdvancedPackageSubItem[]
  adv_packages            AdvancedTravelPackage[]
  bank_accounts           BankAccount[]
  chat_histories          ChatHistory[]
  customer_crm_history    CustomerCrmHistory[]
  customer_managements    CustomerManagement[]
  customer_requests       CustomerRequest[]
  customer_schedules      CustomerSchedule[]
  customer_service_labels CustomerServiceLabel[]
  customer_stats          CustomerStat[]
  date_requests           DateRequest[]
  document_chunks         document_chunks[]
  email_account           EmailAccount?
  email_messages          EmailMessage[]
  global_settings         GlobalSetting[]
  invoice_templates       InvoiceTemplate[]
  invoices                Invoice[]
  kb_media_contexts       KbMediaContext[]
  kb_media_files          KbMediaFile[]
  knowledge_bases         KnowledgeBase[]
  leads                   Lead[]
  main_pkg_media_files    MainPackageMediaFile[]
  message_queues          MessageQueue[]
  mode_change_logs        ModeChangeLog[]
  offers                  Offer[]
  order_form_configs      OrderFormConfig[]
  order_forms             OrderForm[]
  package_media_contexts  PackageMediaContext[]
  package_media_files     PackageMediaFile[]
  adv_availability_rules  PackageAvailabilityRule[]
  adv_price_overrides     PackagePriceOverride[]
  adv_slot_overrides      PackageSlotOverride[]
  rag_context_caches      RagContextCache[]
  refund_requests         RefundRequest[]
  rental_requests         RentalRequest[]
  rental_units            RentalUnit[]
  reschedule_requests     RescheduleRequest[]
  schedule_contacts       ScheduleContact[]
  schedule_followups      ScheduleFollowupQueue[]
  schedules               Schedule[]
  service_labels          ServiceLabel[]
  session_managers        SessionManager[]
  status_informations     StatusInformation[]
  subitem_media_files     SubItemMediaFile[]
  telegram_account        TelegramAccount?
  phone_numbers           TenantPhoneNumber[]
  traffic_sources         TrafficSource[]
  transactions            Transaction[]
  travel_bookings         TravelBooking[]
  travel_packages         TravelPackage[]
  users                   User[]
  central_info_requests   CentralInfoRequest[]
  system_guider_chats    SystemGuiderChat[]
  system_guider_todos    SystemGuiderTodo[]
  customer_interaction_logs CustomerInteractionLog[]
  ai_credit               TenantAiCredit?
  ai_credit_usage_logs    AiCreditUsageLog[]
  cm_request_items        CmRequestItem[]
  cm_chats                CmChat[]
  subscription_payments   SubscriptionPayment[]

  @@map("tenants")
}

model SubscriptionPayment {
  id                 Int       @id @default(autoincrement()) @db.UnsignedInt
  tenant_id          Int       @db.UnsignedInt
  order_id           String    @unique @db.VarChar(100)
  gross_amount       Float     @db.Double
  plan_name          String    @db.VarChar(100)
  payment_type       String?   @db.VarChar(50)
  transaction_status String    @default("pending") @db.VarChar(50)
  paid_at            DateTime? @db.DateTime(0)
  created_at         DateTime? @default(now()) @db.DateTime(0)
  updated_at         DateTime? @default(now()) @db.DateTime(0)
  
  tenant             Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id], map: "idx_sub_payment_tenant")
  @@map("subscription_payments")
}

model User {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  tenant_id  Int       @db.UnsignedInt
  name       String    @db.VarChar(150)
  username   String?   @unique @db.VarChar(100)
  email      String    @unique @db.VarChar(200)
  password   String    @db.VarChar(255)
  role               String    @default("admin") @db.VarChar(50)
  is_active          Int       @default(1) @db.TinyInt
  email_verified_at       DateTime? @db.DateTime(0)
  verification_token      String?   @db.VarChar(255)
  verification_expires_at DateTime? @db.DateTime(0)
  created_at              DateTime? @default(now()) @db.DateTime(0)
  updated_at         DateTime? @default(now()) @db.DateTime(0)
  tenant             Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id], map: "idx_tenant")
  @@map("users")
}

model Lead {
  id                      Int         @id @default(autoincrement()) @db.UnsignedInt
  tenant_id               Int         @db.UnsignedInt
  phone                   String      @db.VarChar(50)
  push_name               String?     @db.VarChar(255)
  saved_name              String?     @db.VarChar(255)
  status                  LeadStatus? @default(baru)
  label                   LeadLabel?  @default(potensial)
  is_manual               Int?        @default(0) @db.TinyInt
  follow_up_sent          Int?        @default(0) @db.TinyInt
  source_step             Int?        @default(0) @db.TinyInt
  traffic_source          String?     @db.VarChar(255)
  former_services         String?     @db.Text
  last_message_at         DateTime?   @db.DateTime(0)
  last_message_preview    String?     @db.Text
  last_ai_reply           String?     @db.Text
  payment_waiting_since   DateTime?   @db.DateTime(0)
  created_at              DateTime?   @default(now()) @db.DateTime(0)
  updated_at              DateTime?   @default(now()) @db.DateTime(0)
  chat_summary            String?     @db.Text
  email                   String?     @db.VarChar(200)
  msg_count_since_summary Int?        @default(0)
  preferences             String?     @db.Text
  channel                 String      @default("whatsapp") @db.VarChar(20)
  platform_ids            String?     @db.Text
  active_topics           String?     @db.Text
  open_questions          Json?       // [{key, question, answer, answered, request_id}]

  // --- Ghost/Idle Timer System ---
  ghost_status            GhostStatus? @default(active)
  ghost_timer_expires_at  DateTime?    @db.DateTime(0)
  ghost_intent            String?      @db.VarChar(20)
  last_ai_reply_at        DateTime?    @db.DateTime(0)

  // --- Platform Identity (cross-platform unification) ---
  whatsapp_phone          String?     @db.VarChar(50)
  telegram_id             String?     @db.VarChar(100)
  instagram_username      String?     @db.VarChar(255)
  profile_photo_url       String?     @db.VarChar(1000)

  // --- Section 1: Identity & Contact ---
  first_name              String?     @db.VarChar(150)
  last_name               String?     @db.VarChar(150)
  position_title          String?     @db.VarChar(200)
  city                    String?     @db.VarChar(100)
  country                 String?     @db.VarChar(100)
  full_address            String?     @db.Text
  linkedin_url            String?     @db.VarChar(500)
  social_media            String?     @db.Text

  // --- Section 2: Profiling (Demographics & Firmographics) ---
  birth_date              DateTime?   @db.Date
  gender                  String?     @db.VarChar(20)
  company_name            String?     @db.VarChar(255)
  industry                String?     @db.VarChar(150)
  company_size            String?     @db.VarChar(50)
  annual_revenue          String?     @db.VarChar(100)
  lead_source             String?     @db.VarChar(100)

  // --- Section 3: Sales / Transaction ---
  pipeline_status         String?     @db.VarChar(50)
  first_purchase_at       DateTime?   @db.DateTime(0)
  last_purchase_at        DateTime?   @db.DateTime(0)
  contract_renewal_at     DateTime?   @db.DateTime(0)
  total_spent             Decimal?    @default(0) @db.Decimal(14, 2)

  // --- Section 5: Preferences & Notes ---
  communication_preference String?    @db.VarChar(50)
  personal_notes          String?     @db.Text
  nps_score               Int?

  tenant                  Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, phone], name: "uk_tenant_phone")
  @@index([status], map: "idx_status")
  @@index([label], map: "idx_label")
  @@index([last_message_at], map: "idx_last_msg")
  @@index([pipeline_status], map: "idx_pipeline")
  @@index([lead_source], map: "idx_lead_source")
  @@index([ghost_status], map: "idx_ghost_status")
  @@index([ghost_timer_expires_at], map: "idx_ghost_timer")
  @@map("leads")
}

model ChatHistory {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  tenant_id       Int       @db.UnsignedInt
  user_phone      String    @db.VarChar(50)
  role            String    @db.VarChar(50)
  message         String    @db.Text
  created_at      DateTime? @default(now()) @db.DateTime(0)
  media_url       String?   @db.VarChar(2000)
  channel         String    @default("whatsapp") @db.VarChar(20)
  media_summary   String?   @db.Text
  is_edited       Int?      @default(0) @db.TinyInt
  provider_msg_id String?   @db.VarChar(255)
  tenant          Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([provider_msg_id], map: "idx_provider_msg")
  @@index([tenant_id, user_phone], map: "idx_tenant_phone")
  @@index([created_at], map: "idx_created")
  @@map("chat_history")
}

model KnowledgeBase {
  id               Int              @id @default(autoincrement()) @db.UnsignedInt
  tenant_id        Int              @db.UnsignedInt
  type             String           @default("custom_info") @db.VarChar(50)
  title            String?          @db.VarChar(255)
  content_text     String?          @db.LongText
  ai_context       String?          @db.Text
  price            Decimal?         @db.Decimal(12, 2)
  original_price   Decimal?         @db.Decimal(12, 2)
  stock            Int?             @default(0)
  slot_unlimited   Int?             @default(0) @db.TinyInt
  is_promo         Int?             @default(0) @db.TinyInt
  promo_context    String?          @db.Text
  image_url        String?          @db.VarChar(500)
  media_path       String?          @db.VarChar(500)
  media_type       String?          @default("none") @db.VarChar(50)
  allow_send_media Int?             @default(0) @db.TinyInt
  info_additional  String?          @db.Text
  created_at       DateTime?        @default(now()) @db.DateTime(0)
  updated_at       DateTime?        @default(now()) @db.DateTime(0)
  media_contexts   KbMediaContext[]
  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, type], map: "idx_tenant_type")
  @@map("knowledge_base")
}

model Transaction {
  id                Int               @id @default(autoincrement()) @db.UnsignedInt
  tenant_id         Int               @db.UnsignedInt
  order_id          String?           @db.VarChar(50)
  user_phone        String            @db.VarChar(50)
  customer_name     String?           @db.VarChar(255)
  destination       String?           @db.VarChar(255)
  pax_count         Int?              @default(1)
  total_price       Decimal?          @default(0.00) @db.Decimal(12, 2)
  proof_image       String?           @db.VarChar(500)
  status            GenericStatus?    @default(pending)
  payment_flow      String?           @db.VarChar(50)
  form_filled       Int?              @default(0) @db.TinyInt
  form_data         String?           @db.Text
  ai_analysis       String?           @db.Text
  detected_amount   Decimal?          @default(0.00) @db.Decimal(12, 2)
  detected_bank     String?           @db.VarChar(100)
  detected_date     String?           @db.VarChar(50)
  sender_name       String?           @db.VarChar(255)
  admin_note        String?           @db.Text
  decline_reason    String?           @db.Text
  waiting_form      Int?              @default(0) @db.TinyInt
  created_at        DateTime?         @default(now()) @db.DateTime(0)
  updated_at        DateTime?         @default(now()) @db.DateTime(0)
  booking_id        Int?              @db.UnsignedInt
  is_modified       Int?              @default(0) @db.TinyInt
  expired_at        DateTime?         @db.DateTime(0)
  followed_up_at    DateTime?         @db.DateTime(0)
  invoice_sent_at   DateTime?         @db.DateTime(0)
  sign_at           DateTime?         @db.DateTime(0)
  customer_requests CustomerRequest[]
  refund_requests   RefundRequest[]
  tenant            Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, order_id], name: "uk_tenant_order")
  @@index([tenant_id, user_phone], map: "idx_tenant_phone")
  @@index([tenant_id, booking_id], map: "idx_tenant_booking")
  @@index([status], map: "idx_status")
  @@map("transactions")
}

model BankAccount {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  tenant_id      Int       @db.UnsignedInt
  bank_name      String    @db.VarChar(100)
  account_number String    @db.VarChar(50)
  account_holder String    @db.VarChar(150)
  created_at     DateTime? @default(now()) @db.DateTime(0)
  tenant         Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id], map: "bank_accounts_tenant_id_fkey")
  @@map("bank_accounts")
}

model GlobalSetting {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  tenant_id     Int       @db.UnsignedInt
  setting_key   String    @db.VarChar(100)
  setting_value String?   @db.Text
  updated_at    DateTime? @default(now()) @db.DateTime(0)
  tenant        Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, setting_key], name: "uk_tenant_setting")
  @@map("global_settings")
}

model SessionManager {
  id                Int            @id @default(autoincrement()) @db.UnsignedInt
  tenant_id         Int            @db.UnsignedInt
  session_id        String         @db.VarChar(100)
  status            SessionStatus? @default(disconnected)
  command           String?        @db.VarChar(20)
  qr_code           String?        @db.LongText
  phone_number      String?        @db.VarChar(50)
  last_connected_at DateTime?      @db.DateTime(0)
  created_at        DateTime?      @default(now()) @db.DateTime(0)
  updated_at        DateTime?      @default(now()) @db.DateTime(0)
  tenant            Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, session_id], name: "uk_tenant_session")
  @@map("session_manager")
}

model MessageQueue {
  id            Int          @id @default(autoincrement()) @db.UnsignedInt
  tenant_id     Int          @db.UnsignedInt
  session_id    String       @db.VarChar(100)
  target        String       @db.VarChar(50)
  phone         String?      @db.VarChar(50)
  message       String       @db.Text
  media_url     String?      @db.VarChar(500)
  status        QueueStatus? @default(pending)
  priority      Int?         @default(5)
  retry_count   Int?         @default(0)
  error_message String?      @db.Text
  created_at    DateTime?    @default(now()) @db.DateTime(0)
  sent_at       DateTime?    @db.DateTime(0)
  channel       String       @default("whatsapp") @db.VarChar(20)
  tenant        Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([status], map: "idx_status")
  @@index([tenant_id, session_id], map: "idx_tenant_session")
  @@index([created_at], map: "idx_created")
  @@map("message_queue")
}

model ModeChangeLog {
  id         Int       @id @default(autoincrement())
  tenant_id  Int       @db.UnsignedInt
  phone      String    @db.VarChar(50)
  is_manual  Int       @default(0) @db.TinyInt
  changed_at DateTime? @default(now()) @db.DateTime(0)
  tenant     Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, phone], map: "idx_tenant_phone")
  @@index([changed_at], map: "idx_changed_at")
  @@map("mode_change_log")
}

model TrafficSource {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  tenant_id       Int       @db.UnsignedInt
  lead_phone      String    @db.VarChar(50)
  session_id      String?   @db.VarChar(100)
  source_raw      String?   @db.Text
  source_category String?   @default("Lainnya") @db.VarChar(100)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  tenant          Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, lead_phone], map: "idx_tenant_phone")
  @@map("traffic_sources")
}

model Schedule {
  id                  Int                     @id @default(autoincrement()) @db.UnsignedInt
  tenant_id           Int                     @db.UnsignedInt
  title               String                  @db.VarChar(255)
  schedule_date       DateTime                @db.Date
  schedule_time       String?                 @db.VarChar(20)
  max_capacity        Int?                    @default(10)
  current_booked      Int?                    @default(0)
  description         String?                 @db.Text
  status              GenericStatus?          @default(active)
  label_ids           String?                 @db.Text
  manual_phones       String?                 @db.Text
  excluded_phones     String?                 @db.Text
  total_contacts      Int?                    @default(0)
  followup_enabled    Int?                    @default(0) @db.TinyInt
  followup_status     String?                 @db.VarChar(50)
  followup_sent_count Int?                    @default(0)
  session_id          String?                 @db.VarChar(100)
  created_at          DateTime?               @default(now()) @db.DateTime(0)
  updated_at          DateTime?               @default(now()) @db.DateTime(0)
  contacts            ScheduleContact[]
  followups           ScheduleFollowupQueue[]
  tenant              Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, schedule_date], map: "idx_tenant_date")
  @@index([status], map: "idx_status")
  @@map("schedules")
}

model ScheduleContact {
  id               Int            @id @default(autoincrement()) @db.UnsignedInt
  tenant_id        Int            @db.UnsignedInt
  schedule_id      Int            @db.UnsignedInt
  phone            String         @db.VarChar(50)
  name             String?        @db.VarChar(255)
  source           String?        @db.VarChar(50)
  is_excluded      Int?           @default(0) @db.TinyInt
  status           GenericStatus? @default(pending)
  followup_sent    Int?           @default(0) @db.TinyInt
  followup_sent_at DateTime?      @db.DateTime(0)
  created_at       DateTime?      @default(now()) @db.DateTime(0)
  schedule         Schedule       @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  tenant           Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([schedule_id], map: "idx_schedule")
  @@index([tenant_id, phone], map: "idx_tenant_phone")
  @@map("schedule_contacts")
}

model ScheduleFollowupQueue {
  id          Int            @id @default(autoincrement()) @db.UnsignedInt
  tenant_id   Int            @db.UnsignedInt
  schedule_id Int            @db.UnsignedInt
  phone       String         @db.VarChar(50)
  name        String?        @db.VarChar(255)
  message     String         @db.Text
  session_id  String?        @db.VarChar(100)
  status      GenericStatus? @default(pending)
  sent_at     DateTime?      @db.DateTime(0)
  created_at  DateTime?      @default(now()) @db.DateTime(0)
  schedule    Schedule       @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  tenant      Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([schedule_id], map: "schedule_followup_queue_schedule_id_fkey")
  @@index([tenant_id], map: "schedule_followup_queue_tenant_id_fkey")
  @@map("schedule_followup_queue")
}

model CustomerSchedule {
  id               Int                 @id @default(autoincrement()) @db.UnsignedInt
  tenant_id        Int                 @db.UnsignedInt
  phone            String              @db.VarChar(50)
  customer_name    String?             @db.VarChar(255)
  service_label    String?             @db.VarChar(100)
  schedule_date    DateTime?           @db.Date
  schedule_time    String?             @db.VarChar(20)
  duration_minutes Int?                @default(60)
  schedule_id      Int?                @db.UnsignedInt
  session_id       String?             @db.VarChar(100)
  status           GenericStatus?      @default(active)
  created_at       DateTime?           @default(now()) @db.DateTime(0)
  updated_at       DateTime?           @default(now()) @db.DateTime(0)
  tenant           Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  reschedules      RescheduleRequest[]

  @@index([tenant_id], map: "customer_schedules_tenant_id_fkey")
  @@map("customer_schedules")
}

model DateRequest {
  id                     Int            @id @default(autoincrement())
  tenant_id              Int            @db.UnsignedInt
  phone                  String         @db.VarChar(50)
  name                   String?        @db.VarChar(255)
  session_id             String?        @db.VarChar(50)
  service_label          String?        @default("") @db.VarChar(100)
  original_message       String?        @db.Text
  requested_date         DateTime?      @db.Date
  requested_time         String?        @db.VarChar(20)
  requested_date_raw     String?        @default("") @db.VarChar(200)
  requested_time_raw     String?        @default("") @db.VarChar(200)
  description            String?        @db.Text
  status                 GenericStatus? @default(pending)
  admin_note             String?        @db.Text
  reject_reason          String?        @db.Text
  approved_schedule_id   Int?           @db.UnsignedInt
  merged_with_request_id Int?           @db.UnsignedInt
  actioned_by            String?        @db.VarChar(100)
  actioned_at            DateTime?      @db.DateTime(0)
  wa_notif_sent          Int?           @default(0) @db.TinyInt
  created_at             DateTime?      @default(now()) @db.DateTime(0)
  tenant                 Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, phone], map: "idx_tenant_phone")
  @@index([status], map: "idx_status")
  @@index([requested_date], map: "idx_date")
  @@map("date_requests")
}

model RescheduleRequest {
  id                    Int               @id @default(autoincrement())
  tenant_id             Int               @db.UnsignedInt
  phone                 String            @db.VarChar(50)
  name                  String?           @db.VarChar(255)
  session_id            String?           @db.VarChar(50)
  service_label         String?           @default("") @db.VarChar(100)
  original_message      String?           @db.Text
  requested_date        DateTime?         @db.Date
  requested_time        String?           @db.VarChar(20)
  requested_date_raw    String?           @default("") @db.VarChar(200)
  current_schedule_date DateTime?         @db.Date
  status                GenericStatus?    @default(pending)
  admin_note            String?           @db.Text
  reject_reason         String?           @db.Text
  customer_schedule_id  Int?              @db.UnsignedInt
  approved_schedule_id  Int?              @db.UnsignedInt
  new_schedule_id       Int?              @db.UnsignedInt
  approved_date         DateTime?         @db.Date
  approved_time         String?           @db.VarChar(20)
  action_type           String?           @db.VarChar(50)
  actioned_by           String?           @db.VarChar(100)
  actioned_at           DateTime?         @db.DateTime(0)
  wa_notif_sent         Int?              @default(0) @db.TinyInt
  created_at            DateTime?         @default(now()) @db.DateTime(0)
  customer_schedule     CustomerSchedule? @relation(fields: [customer_schedule_id], references: [id])
  tenant                Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, phone], map: "idx_tenant_phone")
  @@index([status], map: "idx_status")
  @@index([customer_schedule_id], map: "reschedule_requests_customer_schedule_id_fkey")
  @@map("reschedule_requests")
